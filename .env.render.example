# Examples only: put the real values in Render Environment, never in Git.
NODE_ENV=production
AUTH_MODE=external
FILE_STORAGE_PROVIDER=database
DB_POOL_MAX=5
DATABASE_URL=postgresql://USER:PASSWORD@YOUR-NEON-HOST/DATABASE?sslmode=require
# Neon pooled hosts automatically use their matching direct host for migrations.
# Optional override for a separate direct migration connection:
# DATABASE_MIGRATION_URL=postgresql://USER:PASSWORD@YOUR-DIRECT-NEON-HOST/DATABASE?sslmode=require
CLERK_PUBLISHABLE_KEY=YOUR_EXTERNAL_CLERK_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_EXTERNAL_CLERK_SECRET_KEY
FRONTEND_URL=https://YOUR-FRONTEND.vercel.app
PUBLIC_API_URL=https://YOUR-BACKEND.onrender.com
OWNER_EMAIL=YOUR_OWNER_EMAIL
